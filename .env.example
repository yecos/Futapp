# ============================================
# Futapp — Variables de entorno
# ============================================
# Copia este archivo a .env y completa los valores
# Para instrucciones detalladas, ver docs/SETUP.md

# ----- BASE DE DATOS (Supabase) -----
# Vercel crea estas variables automáticamente al integrar Supabase:
#   POSTGRES_PRISMA_URL      → URL con pooler (pgbouncer) para runtime serverless
#   POSTGRES_URL_NON_POOLING → URL directa para migraciones
#
# Si configuras manualmente (desarrollo local), usa estos nombres:
POSTGRES_PRISMA_URL="postgresql://postgres.pcazcdzdcyiwcmstidxw:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
POSTGRES_URL_NON_POOLING="postgresql://postgres.pcazcdzdcyiwcmstidxw:PASSWORD@db.pcazcdzdcyiwcmstidxw.supabase.co:5432/postgres"

# ----- AUTENTICACIÓN -----
# URL completa de la app (sin slash final)
# Dev:  http://localhost:3000
# Prod: https://tu-dominio.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Secreto para firmar JWTs (genera con: openssl rand -base64 32)
NEXTAUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Crea OAuth 2.0 Client ID de tipo Web
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
#   - https://tu-dominio.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----- SUPABASE (Vercel crea estas variables automáticamente) -----
# Vercel crea estas variables al integrar Supabase:
#   SUPABASE_URL               → https://pcazcdzdcyiwcmstidxw.supabase.co
#   SUPABASE_PUBLISHABLE_KEY   → sb_publishable_... (clave pública, reemplaza anon)
#   SUPABASE_SECRET_KEY        → sb_secret_... (clave secreta, reemplaza service_role)
#   SUPABASE_JWT_SECRET        → secreto interno para JWT
#
# En desarrollo local, cópialas manualmente:
NEXT_PUBLIC_SUPABASE_URL="https://pcazcdzdcyiwcmstidxw.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# ----- CRON JOBS -----
# Secreto para proteger /api/cron/* (genera con: openssl rand -base64 32)
# Configurar en Vercel → Settings → Cron Jobs con header Authorization: Bearer <valor>
CRON_SECRET=""

# ----- STORAGE BUCKETS -----
# Crear buckets en Supabase Storage:
#   - team-assets (público para escudos y fotos)
#   - payment-receipts (PRIVADO - solo access via URL firmada)
STORAGE_BUCKET_TEAM="team-assets"
STORAGE_BUCKET_RECEIPTS="payment-receipts"

# ----- APP (opcional) -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
