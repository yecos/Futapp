# ============================================
# Futapp — Variables de entorno
# ============================================
# Copia este archivo a .env y completa los valores
# Para instrucciones detalladas, ver docs/SETUP.md

# ----- BASE DE DATOS (Neon Postgres) -----
# Crea una cuenta gratis en https://neon.tech
# 1. Crea un proyecto nuevo
# 2. Copia la "Connection string" del pooler (Pooled connection):
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# 3. Copia la "Connection string" directa (sin -pooler):
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXX.REGION.aws.neon.tech/neondb?sslmode=require"

# ----- AUTENTICACIÓN -----
# URL completa de la app (sin slash final)
# Dev:  http://localhost:3000
# Prod: https://tu-dominio.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Secreto para firmar JWTs (genera con: openssl rand -base64 32)
NEXTAUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Crea OAuth 2.0 Client ID de tipo Web
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
#   - https://tu-dominio.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----- CRON JOBS -----
# Secreto para proteger /api/cron/* (genera con: openssl rand -base64 32)
# Configurar en Vercel → Settings → Cron Jobs con header Authorization: Bearer <valor>
CRON_SECRET=""

# ----- APP (opcional) -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
