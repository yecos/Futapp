// Futapp - Schema Prisma para PostgreSQL (Supabase)
// Gestión deportiva multi-usuario con roles, pagos y eventos

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Neon Postgres — variables de entorno
  // DATABASE_URL: connection pooler (pgbouncer) para runtime serverless (Vercel)
  // DIRECT_URL: conexión directa para migraciones Prisma
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum Role {
  ADMIN
  ENTRENADOR
  JUGADOR
  CUERPO_TECNICO
  ACUDIENTE
  SEGUIDOR
}

enum EventType {
  ENTRENAMIENTO
  PARTIDO
  TORNEO
  REUNION
  EVENTO
}

enum EventStatus {
  PROGRAMADO
  COMPLETADO
  CANCELADO
}

enum AttendanceStatus {
  ASISTIRE
  NO_ASISTIRE
  TAL_VEZ
}

enum CallupStatus {
  TITULAR
  SUPLENTE
  NO_CONVOCADO
}

enum PlayerStatus {
  DISPONIBLE
  LESIONADO
  SUSPENDIDO
  AUSENTE
}

enum Position {
  PORTERO
  DEFENSA
  MEDIOCAMPISTA
  DELANTERO
}

enum Foot {
  DIESTRO
  ZURDO
  AMBIDIESTRO
}

enum AnnouncementCategory {
  GENERAL
  CONVOCATORIA
  EVENTO
  URGENTE
  PAGO
}

enum PaymentType {
  MENSUALIDAD
  ARBITRAJE
  UNIFORME
  INSCRIPCION
  EVENTO
  MULTA
  OTRO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  VERIFICADO
  RECHAZADO
  VENCIDO
}

enum PaymentRecurrence {
  UNICO
  MENSUAL
  SEMESTRAL
  ANUAL
}

enum MembershipStatus {
  ACTIVO
  PENDIENTE
  RETIRADO
  BLOQUEADO
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDIENTE
  ENVIADA
  FALLIDA
  LEIDA
}

// =====================================================
// NEXTAUTH ADAPTER MODELS (Account, Session, VerificationToken)
// =====================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  phoneNumber   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // App relations
  memberships       TeamMembership[]
  playerProfile     Player?
  guardianOf        Player[]         @relation("PlayerGuardian")
  announcements     Announcement[]
  paymentsCreated   Payment[]
  paymentsVerified  Payment[]        @relation("PaymentVerifier")
  receiptsUploaded  PaymentReceipt[]
  notifications     Notification[]
  invitesCreated    InviteToken[]
  inviteUsed        InviteToken?     @relation("InviteTokenUsed")
  eventMessages     EventMessage[]
  freePlayerProfile FreePlayer?
  openingsCreated   Opening[]          @relation("OpeningCreator")
  applicationsResponded Application[]  @relation("ApplicationResponder")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================
// TEAM & MEMBERSHIP
// =====================================================

model Team {
  id              String   @id @default(cuid())
  name            String
  shortName       String
  category        String
  coachName       String
  primaryColor    String   @default("#16a34a")
  secondaryColor  String?
  foundedYear     Int
  logoUrl         String?
  description     String?

  // Datos bancarios para QR Bancolombia
  bankName            String  @default("Bancolombia")
  accountType         String  @default("Ahorros")
  accountNumber       String?
  accountHolder       String?
  qrImageUrl          String?
  paymentInstructions String?

  onboardingCompleted Boolean @default(false)
  isActive            Boolean @default(true)

  // Fase 3 — Monetización (Capa 2)
  isPremium           Boolean  @default(false)
  premiumUntil        DateTime?
  // Comisión sobre cobros QR (1-3%)
  commissionRate      Float    @default(0) // 0 = sin comisión, 0.02 = 2%

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   TeamMembership[]
  events        Event[]
  players       Player[]
  announcements Announcement[]
  payments      Payment[]
  standings     Standing[]
  invites       InviteToken[]
  openings      Opening[]

  @@index([isActive])
}

model TeamMembership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      Role
  status    MembershipStatus @default(PENDIENTE)
  invitedBy String?
  invitedAt DateTime?
  acceptedAt DateTime?
  joinedAt  DateTime?
  leftAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, role])
  @@index([userId])
}

// =====================================================
// PLAYERS
// =====================================================

model Player {
  id              String   @id @default(cuid())
  teamId          String
  userId          String?  @unique  // vinculado si el jugador tiene cuenta
  guardianId      String?  // si es categoría infantil, acudiente User

  firstName       String
  lastName        String
  fullName        String
  jerseyNumber    Int
  primaryPosition Position
  secondaryPosition Position?
  age             Int
  birthDate       DateTime?
  dominantFoot    Foot     @default(DIESTRO)
  height          Int?
  weight          Int?
  phone           String?
  emergencyContact String?
  photoUrl        String?
  status          PlayerStatus @default(DISPONIBLE)

  // Stats cacheadas (se actualizan al guardar MatchStat)
  matchesPlayed    Int @default(0)
  goals            Int @default(0)
  assists          Int @default(0)
  yellowCards      Int @default(0)
  redCards         Int @default(0)
  trainingsAttended Int @default(0)
  trainingsTotal   Int @default(0)

  // RPG / Gamificación (v2.1)
  statPoints         Int @default(0)  // puntos disponibles para distribuir
  totalPointsEarned  Int @default(0)  // total histórico
  streak             Int @default(0)  // racha actual de check-ins
  maxStreak          Int @default(0)  // racha máxima
  basePAC            Int @default(0)  // Pace
  baseSHO            Int @default(0)  // Shooting
  basePAS            Int @default(0)  // Passing
  baseDRI            Int @default(0)  // Dribbling
  baseDEF            Int @default(0)  // Defending
  basePHY            Int @default(0)  // Physical

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id])
  guardian  User?      @relation("PlayerGuardian", fields: [guardianId], references: [id])
  attendances Attendance[]
  callups    Callup[]
  matchStats MatchStat[]
  receipts   PaymentReceipt[]
  checkIns   CheckIn[]
  absences   Absence[]

  @@unique([teamId, jerseyNumber])
  @@index([teamId, status])
  @@index([userId])
  @@index([guardianId])
}

// =====================================================
// EVENTS, ATTENDANCE, CALLUPS, MATCH STATS
// =====================================================

model Event {
  id          String   @id @default(cuid())
  teamId      String
  type        EventType
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  location    String
  opponent    String?
  isHome      Boolean?
  status      EventStatus @default(PROGRAMADO)
  homeScore   Int?
  awayScore   Int?
  formation   String?
  createdBy   String
  latitude    Float?   // GPS para check-in
  longitude   Float?   // GPS para check-in
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  callups     Callup[]
  matchStats  MatchStat[]
  checkIns    CheckIn[]
  absences    Absence[]
  messages    EventMessage[]

  @@index([teamId, date])
  @@index([teamId, status, date])
}

model Attendance {
  id        String           @id @default(cuid())
  eventId   String
  playerId  String
  status    AttendanceStatus?
  note      String?
  updatedAt DateTime         @updatedAt
  updatedBy String

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([eventId, status])
}

model Callup {
  id            String       @id @default(cuid())
  eventId       String
  playerId      String
  teamId        String
  status        CallupStatus
  positionLabel String?  // POR, LI, DFC, etc.
  fieldPosition String?  // "x,y" coords
  isCaptain     Boolean  @default(false)
  order         Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([eventId, status])
}

model MatchStat {
  id             String   @id @default(cuid())
  eventId        String
  playerId       String
  teamId         String
  goals          Int      @default(0)
  assists        Int      @default(0)
  minutesPlayed  Int      @default(0)
  yellowCards    Int      @default(0)
  redCards       Int      @default(0)
  saves          Int      @default(0)
  shots          Int      @default(0)
  recoveries     Int      @default(0)
  isMotm         Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([playerId, eventId])
  @@index([eventId, isMotm])
}

// =====================================================
// ANNOUNCEMENTS
// =====================================================

model Announcement {
  id          String              @id @default(cuid())
  teamId      String
  title       String
  content     String
  category    AnnouncementCategory @default(GENERAL)
  authorId    String
  authorRole  Role
  pinned      Boolean             @default(false)
  publishedAt DateTime
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  team   Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author User              @relation(fields: [authorId], references: [id])
  reads  AnnouncementRead[]

  @@index([teamId, publishedAt])
  @@index([teamId, pinned, publishedAt])
}

model AnnouncementRead {
  id              String   @id @default(cuid())
  announcementId  String
  userId          String
  readAt          DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

// =====================================================
// STANDINGS (TABLA DE POSICIONES)
// =====================================================

model Standing {
  id            String   @id @default(cuid())
  teamId        String
  tournamentName String
  teamName      String
  isOurTeam     Boolean  @default(false)
  played        Int      @default(0)
  won           Int      @default(0)
  drawn         Int      @default(0)
  lost          Int      @default(0)
  goalsFor      Int      @default(0)
  goalsAgainst  Int      @default(0)
  points        Int      @default(0)
  position      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, tournamentName, teamName])
  @@index([teamId, tournamentName, points])
}

// =====================================================
// PAYMENTS (COBROS + COMPROBANTES)
// =====================================================

model Payment {
  id          String           @id @default(cuid())
  teamId      String
  title       String
  description String?
  type        PaymentType
  amount      Decimal          @db.Decimal(12, 2)
  currency    String           @default("COP")
  dueDate     DateTime
  recurrence  PaymentRecurrence @default(UNICO)
  appliesTo   Json?            // ["ALL"] o ["playerId1", "playerId2"]
  status      PaymentStatus    @default(PENDIENTE)
  parentPaymentId String?      // para recurrentes generados
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  verifiedBy  String?
  verifiedAt  DateTime?

  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator  User             @relation(fields: [createdBy], references: [id])
  verifier User?            @relation("PaymentVerifier", fields: [verifiedBy], references: [id])
  receipts PaymentReceipt[]

  @@index([teamId, status, dueDate])
  @@index([teamId, type])
  @@index([parentPaymentId])
}

model PaymentReceipt {
  id              String        @id @default(cuid())
  paymentId       String
  teamId          String
  playerId        String
  uploadedBy      String
  receiptUrl      String        // path en Supabase Storage
  amount          Decimal?      @db.Decimal(12, 2)
  reference       String?
  notes           String?
  status          PaymentStatus @default(PAGADO)
  uploadedAt      DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedBy], references: [id])

  @@index([paymentId, status])
  @@index([teamId, status])
  @@index([playerId])
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  id               String              @id @default(cuid())
  teamId           String
  userId           String?
  type             String              // PAYMENT_REMINDER, ANNOUNCEMENT, CALLUP, etc.
  title            String
  body             String
  data             Json?
  channel          NotificationChannel @default(IN_APP)
  status           NotificationStatus  @default(PENDIENTE)
  sentAt           DateTime?
  readAt           DateTime?
  relatedEntityType String?
  relatedEntityId  String?
  createdAt        DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([teamId, type, status])
}

// =====================================================
// EVENT MESSAGES (Chat por evento)
// =====================================================

model EventMessage {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([userId])
}

// =====================================================
// CHECK-IN & ABSENCES (Gamificación v2.1)
// =====================================================

model CheckIn {
  id            String   @id @default(cuid())
  eventId       String
  playerId      String
  userId        String
  latitude      Float?
  longitude     Float?
  distance      Int?     // metros de distancia al evento
  pointsAwarded Int      @default(0)
  isLate        Boolean  @default(false)
  createdAt     DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([playerId, createdAt])
  @@index([eventId])
}

model Absence {
  id        String   @id @default(cuid())
  eventId   String
  playerId  String
  userId    String
  reason    String   // Lesión, Trabajo, Familia, Estudio, Otro
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([playerId])
}

// =====================================================
// INVITE TOKENS
// =====================================================

model InviteToken {
  id        String   @id @default(cuid())
  teamId    String
  createdBy String
  token     String   @unique
  email     String?
  role      Role
  expiresAt DateTime
  usedBy    String?  @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())

  team    Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator User  @relation(fields: [createdBy], references: [id])
  used   User?  @relation("InviteTokenUsed", fields: [usedBy], references: [id])

  @@index([teamId, expiresAt])
}

// =====================================================
// FREE PLAYER (Fase 2 — Jugador libre sin equipo)
// =====================================================

enum TestType {
  SALTO_VERTICAL
  SPRINT_10M
  SPRINT_20M
  CAMBIO_DIRECCION
  TOQUES_BALON
  ANTROPOMETRIA
}

enum VerificationStatus {
  SIN_VERIFICAR
  VERIFICADO
  RECHAZADO
}

model FreePlayer {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Datos básicos
  fullName        String
  age             Int
  city            String?
  zone            String?  // barrio/comuna
  photoUrl        String?  // base64 o URL
  // Datos deportivos
  primaryPosition Position
  secondaryPosition Position?
  dominantFoot    Foot     @default(DIESTRO)
  height          Int?
  weight          Int?
  // Carta
  bio             String?  @db.Text
  isPublic        Boolean  @default(true)
  // Stats derivadas de tests (cacheadas)
  bestVerticalJumpCm  Int?  // mejor salto vertical en cm
  bestSprint10Sec     Float? // mejor sprint 10m en segundos
  bestSprint20Sec     Float? // mejor sprint 20m en segundos
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testResults TestResult[]
  applications Application[]

  @@index([city, zone])
  @@index([primaryPosition])
}

model TestResult {
  id              String             @id @default(cuid())
  freePlayerId    String
  type            TestType
  // Valor medido (unidad depende del tipo)
  value           Float
  unit            String             // "cm", "seg", "toques", etc
  // Video evidencia (base64 o URL)
  videoUrl        String?            @db.Text
  // Verificación
  status          VerificationStatus @default(SIN_VERIFICAR)
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  // Metadata del dispositivo en el momento del test
  deviceInfo      String?
  gpsLat          Float?
  gpsLng          Float?
  recordedAt      DateTime           // momento real de la grabación
  createdAt       DateTime           @default(now())

  freePlayer FreePlayer @relation(fields: [freePlayerId], references: [id], onDelete: Cascade)

  @@index([freePlayerId, type, createdAt])
  @@index([type, value])
}

// =====================================================
// MARKETPLACE (Fase 4 — Conexión equipos ↔ jugadores libres)
// =====================================================

enum OpeningStatus {
  ABIERTA
  CERRADA
  CUBIERTA
  CANCELADA
}

enum ApplicationStatus {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  RETIRADA
}

model Opening {
  id          String        @id @default(cuid())
  teamId      String
  createdBy   String
  // Detalle del cupo
  title       String
  description String?
  position    Position      // posición requerida
  city        String?
  zone        String?
  // Reward / compensación (opcional)
  compensation String?
  // Estado
  status      OpeningStatus @default(ABIERTA)
  // Destaque (pago para aparecer primero)
  isHighlighted Boolean      @default(false)
  highlightedUntil DateTime?
  // Vigencia
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator     User          @relation("OpeningCreator", fields: [createdBy], references: [id])
  applications Application[]

  @@index([teamId, status])
  @@index([position, status])
  @@index([city, zone, status])
  @@index([isHighlighted, createdAt])
}

model Application {
  id          String           @id @default(cuid())
  openingId   String
  freePlayerId String
  // Mensaje del jugador al postular
  message     String?          @db.Text
  // Estado
  status      ApplicationStatus @default(PENDIENTE)
  // Respuesta del equipo
  teamResponse String?          @db.Text
  respondedAt DateTime?
  respondedBy  String?
  // Contacto compartido (cuando es ACEPTADA)
  contactShared Boolean        @default(false)
  // Metadata
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  opening    Opening     @relation(fields: [openingId], references: [id], onDelete: Cascade)
  freePlayer FreePlayer  @relation(fields: [freePlayerId], references: [id], onDelete: Cascade)
  responder  User?       @relation("ApplicationResponder", fields: [respondedBy], references: [id])

  @@unique([openingId, freePlayerId])
  @@index([freePlayerId, status])
  @@index([openingId, status])
}
